# Personal finance workspace: every input, decision, output and backup. Unanchored so a script run
# from a subfolder cannot create a trackable private/ tree.
private/
/data/
/dropbox/
/inbox/
/config/
/proposals/
/build/
/reports/
/backups/
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.log
*.sql

# Bank exports and statements. Test fixtures are generated inline; none are tracked.
*.csv
*.tsv
*.ofx
*.qfx
*.qif
*.xls
*.xlsx
*.pdf

# Validation screenshots and captures.
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.mp4
*.webm
!/assets/icons/*.png
!/assets/icons/*.ico

# Configuration export (accounts, people, events, aliases, rules): personal definitions, kept in the
# private urbanomics-configuration repository. Only the explanation stays here.
/configuration/*
!/configuration/README.md

# Credentials and local settings
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
workspace.json
remote-access.json
remote-status.json
.claude/settings.local.json

# Runtime and editor output
node_modules/
dist/
.next/
.svelte-kit/
.venv/
__pycache__/
.pytest_cache/
.DS_Store
Thumbs.db
.idea/
.vscode/
*.stackdump
/release/
/test-results/
/playwright-report/
