{
  "name": "urbanomics",
  "version": "0.1.0",
  "private": true,
  "description": "Local desktop finance workspace",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "npm run build && electron .",
    "build": "vite build",
    "dev": "vite --host 127.0.0.1",
    "desktop:dev": "electron . --dev",
    "test": "node --test tests/desktop/*.test.cjs",
    "test:prototypes": "node --test tests/*-prototype.test.cjs",
    "test:desktop": "node scripts/smoke-desktop.cjs",
    "test:dashboard": "node scripts/smoke-dashboard.cjs",
    "test:money-in": "node scripts/smoke-money-in.cjs",
    "test:events": "node scripts/smoke-events.cjs",
    "test:review": "node scripts/smoke-review.cjs",
    "test:review-flow": "node scripts/smoke-review-flow.cjs",
    "test:mobile": "node scripts/smoke-mobile.cjs",
    "test:experimental": "node --test tests/desktop/experimental.test.cjs && node scripts/smoke-experimental.cjs",
    "test:system-tags": "node --test tests/desktop/system-tags.test.cjs && node scripts/smoke-system-tags.cjs",
    "test:virtual-roll": "node scripts/smoke-virtual-roll.cjs",
    "test:orbit": "node scripts/smoke-orbit.cjs",
    "test:organize": "node scripts/smoke-organize.cjs",
    "test:organize-desk": "node scripts/smoke-organize-desk.cjs",
    "test:rules": "node scripts/smoke-rules.cjs",
    "test:aliases": "node scripts/smoke-aliases.cjs",
    "test:transfer-lab": "node scripts/smoke-transfer-lab.cjs",
    "test:transfers": "node scripts/smoke-transfers.cjs",
    "package:win": "npm run build && electron-builder --win dir",
    "dist:win": "npm run build && electron-builder --win nsis --publish never --config electron-builder.release.yml",
    "release": "node scripts/release.cjs",
    "web": "npm run build && node electron/web-server.cjs",
    "remote:setup": "node scripts/setup-remote.cjs",
    "docs:serve": "node scripts/serve-experience-map.cjs",
    "prototype:ingest": "vite build --config prototypes/ingest/vite.config.mjs"
  },
  "dependencies": {
    "@derekurban/design-system": "github:derekurban/design-system#v0.1.0",
    "csv-parse": "7.0.2",
    "electron-updater": "^6.8.9",
    "lucide": "0.460.0",
    "re2-wasm": "1.0.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.63.0",
    "vite": "8.2.2"
  }
}
