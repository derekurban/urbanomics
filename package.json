{
  "name": "urbanomics",
  "version": "0.1.0",
  "private": true,
  "description": "Local desktop finance workspace",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "npm run build && electron .",
    "build": "vite build",
    "dev": "vite --host 127.0.0.1",
    "desktop:dev": "electron . --dev",
    "test": "node --test tests/desktop/*.test.cjs",
    "test:prototypes": "node --test tests/*-prototype.test.cjs",
    "test:desktop": "node scripts/smoke-desktop.cjs",
    "test:dashboard": "node scripts/smoke-dashboard.cjs",
    "test:money-in": "node scripts/smoke-money-in.cjs",
    "test:events": "node scripts/smoke-events.cjs",
    "test:review": "node scripts/smoke-review.cjs",
    "test:orbit": "node scripts/smoke-orbit.cjs",
    "test:organize": "node scripts/smoke-organize.cjs",
    "test:aliases": "node scripts/smoke-aliases.cjs",
    "test:transfers": "node scripts/smoke-transfers.cjs",
    "package:win": "npm run build && electron-builder --win dir"
  },
  "dependencies": {
    "csv-parse": "7.0.2",
    "re2-wasm": "1.0.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.63.0",
    "vite": "8.2.2"
  }
}
